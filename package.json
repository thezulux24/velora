{
  "name": "velora",
  "version": "1.0.0",
  "private": true,
  "description": "Landing de Velora (agencia de marketing con agentes de IA) sobre @latinovation/cms-client: 100 % editable desde /portal de WebProAI CMS",
  "scripts": {
    "dev": "next dev -p 3020",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "cms:pull": "node ../cms-landings/packages/cms-cli/bin/ltn.js pull velora --out ./cms",
    "cms:build": "node cms/seed/build-manifest.mjs",
    "cms:diff": "node ../cms-landings/packages/cms-cli/bin/ltn.js push velora --dry-run --skip-collections --strict-keys --file cms/velora.snapshot.json",
    "cms:push": "node ../cms-landings/packages/cms-cli/bin/ltn.js push velora --overwrite --skip-collections --strict-keys --file cms/velora.snapshot.json",
    "cms:audit": "node node_modules/@latinovation/cms-client/bin/audit-editability.mjs --slug velora --url http://localhost:3020 --min 95"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@latinovation/cms-client": "file:vendor/latinovation-cms-client-4.3.1.tgz",
    "lucide-react": "^1.68.0",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
